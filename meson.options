option(
    'dev_mode',
    type: 'boolean',
    value: false,
    description: 'Sets the N00B_DEV define; this is primarily to enable some diagnostic routines in the compiler for printing during debugging, etc.',
)

option(
    'enable_lto',
    type: 'boolean',
    value: false,
    description: 'Enable link-time optimizations',
)

option(
    'build_tests',
    type: 'boolean',
    value: false,
    description: 'Build the ~470 unit/integration test executables as part of '
               + 'the default `meson compile` / `ninja` target. Off by default '
               + 'so the normal edit-build loop only compiles libn00b and the '
               + 'shipped tools, not the whole test suite. `meson test` still '
               + 'builds whatever tests it needs on demand regardless of this '
               + 'flag, so leaving it off costs you nothing when running tests.')

option(
    'fast_linker',
    type: 'combo',
    choices: ['auto', 'off', 'mold', 'lld'],
    value: 'auto',
    description: 'Use a faster linker when available. `auto` probes for mold '
               + 'then lld and uses the first the compiler accepts via '
               + '`-fuse-ld=`, silently falling back to the default linker if '
               + 'neither works. `off` always uses the default. Set `mold`/'
               + '`lld` to require a specific one. Biggest win on Linux/Docker, '
               + 'where the default BFD linker is slow over the ~470 test '
               + 'executables; macOS already ships a fast linker.')

option(
    'enable_ryu_fp',
    type: 'boolean',
    value: true,
    description: 'Link the Ryū precision float formatter (correctly-rounded ' +
                 '%.*f/%.*e/%.*g, malloc-free). Adds ~329 KB of static table. ' +
                 'Disable to fall back to the weak Grisu2+round approximation.',
)

option(
    'enable_libzip',
    type: 'boolean',
    value: true,
    description: 'Build the ZIP chalk codec with libzip when available. ' +
                 'Disable for signed/static deployments that must not link ' +
                 'host-provided third-party dylibs.',
)

option(
    'show_gc_stats',
    type: 'feature',
    value: 'auto',
    description: 'Print basic stats after collections',
)

option(
    'rocs_trace',
    type: 'boolean',
    value: false,
    description: 'Compile ROCS ingest/shard memory instrumentation to stderr.',
)

option(
    'rocs_trace_every',
    type: 'integer',
    value: 256,
    description: 'When rocs_trace is enabled, emit ingest trace every N committed records; 0 disables periodic ingest lines but keeps seal lines.',
)

option(
    'use_memcheck',
    type: 'combo',
    choices: ['off', 'on', 'strict'],
    value: 'off',
    description: 'Enable internal lightweight heap checks',
)

option(
    'use_asan',
    type: 'feature',
    value: 'disabled',
    description: 'Use address sanitizer. Default off — n00b does its own memory management, so ASAN provides limited signal and significantly slows the test suite. Opt in explicitly via `-Duse_asan=enabled` (or N00B_BUILD_ASAN=1 via build.sh).',
)

option(
    'use_ubsan',
    type: 'feature',
    value: 'auto',
    description: 'Use undefined behavior sanitizer',
)

option(
    'enable_debug',
    type: 'boolean',
    value: false,
    description: 'Enable debug logging, setting N00B_DEBUG. Any debug logging option is ignored if this is false.'
    )

option(
    'debug_live_census',
    type: 'boolean',
    value: false,
    description: 'Compile the per-allocation-site live GC census without enabling full N00B_DEBUG. Diagnostics-only.'
    )
    
option('vcpkg_lib',
        type: 'string',
        value: '',
        description: 'vcpkg lib path')

option('vcpkg_inc',
        type: 'string',
        value: '',
        description: 'vcpkg include path')

option('libgit2_inc',
        type: 'string',
        value: '',
        description: 'libgit2 include directory for native Windows builds without pkg-config')

option('libgit2_lib',
        type: 'string',
        value: '',
        description: 'libgit2 import/static library path for native Windows builds without pkg-config')

option('zlib_inc',
        type: 'string',
        value: '',
        description: 'zlib include directory for native Windows builds without pkg-config')

option('zlib_lib',
        type: 'string',
        value: '',
        description: 'zlib library path for native Windows builds without pkg-config')

option('using_musl',
    type: 'boolean',
    value: false)

option('using_build_script',
    type: 'boolean',
    value: false)

option('enable_static_grammar_image',
    type: 'boolean',
    value: true,
    description: 'Build the naudit c_ncc static grammar image, linked lookup path, and regression tests on supported object hosts; unsupported hosts register visible skip tests and use runtime BNF fallback.')

option('skip_vcs_check',
    type: 'boolean',
    value: false,
    description: 'Skip the jj-workspace / main-up-to-date guard (e.g. for ' +
                 'release tarballs or CI checkouts with no .jj). Only set ' +
                 'this when you knowingly build outside a synced jj workspace.')

option('enable_cocoa',
    type: 'boolean',
    value: true,
    description: 'Build the Cocoa rendering backend (macOS only).')

option('enable_notcurses',
    type: 'boolean',
    value: true,
    description: 'Build the notcurses rendering backend (requires notcurses >= 3.0.10).')

option('enable_x11',
    type: 'boolean',
    value: false,
    description: 'Build the X11 rendering backend (Linux/Unix GUI window backend).')

option('enable_freetype',
    type: 'boolean',
    value: true,
    description: 'Build with FreeType font rendering (required for pixel text in notcurses).')

# ----------------------------------------------------------------------
# n00b_attest module — signer backends
# ----------------------------------------------------------------------
# TODO(WP-002): this option is a placeholder declared in WP-001 Phase 1
# so the value space is reserved on the build surface before any signer
# backend ships. It is intentionally NOT consumed by any meson logic in
# this WP — there are no backends yet, and the choice has no effect on
# the produced libn00b. WP-002 (signing) wires the first real value
# ('file') through to a conditional `n00b_attest_src` extension and
# starts switching on the value here. Until then this is a no-op knob.
option('attest_backend',
    type: 'combo',
    choices: ['none', 'file', 'env', 'keychain', 'op', 'vault',
              'aws_sm', 'gcp_sm', 'az_kv'],
    value: 'none',
    description: 'n00b_attest signer backend (no-op placeholder; WP-001 reserves the option name, WP-002 wires the first real value).')

# ----------------------------------------------------------------------
# libn00b_aws — optional AWS substrate over the n00b-aws-shim cdylib
# ----------------------------------------------------------------------
# When enabled, builds libn00b_aws as a pure-C wrap of `n00b-aws-shim`,
# a Rust cdylib that re-exports aws-sdk-rust operations as `extern "C"`.
# At build time we run `~/slop/bin/demangle` against the shim to
# generate the C header that libn00b_aws includes; at runtime the C
# code dlsyms the shim symbols. No libc++ in this loop — only Tokio
# (loaded via the shim's own dependencies).
#
# Per D-062 amended 2026-05-27 (see [[project_n00b_aws_via_rust_shim]]
# in auto-memory).
#
# Requires the prebuilt shim. macOS: `brew install n00b-aws-rust`
# (forthcoming tap); Linux: apt PPA; Windows: vcpkg port. During
# development the in-repo Rust crate at subprojects/n00b-aws-shim/
# satisfies the dependency without external install.
option('enable_aws',
    type: 'boolean',
    value: false,
    description: 'Build libn00b_aws (requires the n00b-aws-shim cdylib).')

option('aws_shim_prefix',
    type: 'string',
    value: '',
    description: 'Optional explicit n00b-aws-shim install prefix. Leave empty to fall back to the in-repo subprojects/n00b-aws-shim/ cargo build.')

option('demangle_bin',
    type: 'string',
    value: '',
    description: 'Optional explicit path to the demangle utility. Leave empty to look up `demangle` on PATH (falling back to ~/slop/bin/demangle when present).')
option('unicode_allow_downloads',
    type: 'boolean',
    value: true,
    description: 'Allow Unicode table generator to download missing cache files from unicode.org on first build. The cache (src/text/unicode/.unicode_cache/) is gitignored, so a fresh workspace cannot build without either auto-download or a pre-populated cache. Set false for offline / reproducible builds — but then the cache must be pre-populated manually before configure.')

option('unicode_strict_cache',
    type: 'boolean',
    value: true,
    description: 'Fail Unicode table generation when conformance test-data files are missing. Required table cache files are always fatal.')

option('unicode_cache_dir',
    type: 'string',
    value: '',
    description: 'Optional Unicode data cache directory. Relative paths are resolved from the source root. Empty uses src/text/unicode/.unicode_cache/.')
