    {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
        "name": "rocs-reader",
        "labels": {
          "app.kubernetes.io/name": "rocs",
          "app.kubernetes.io/component": "reader"
        }
      },
      "spec": {
