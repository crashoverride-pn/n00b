            }
          },
          "spec": {
            "serviceAccountName": "rocs-service",
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "rocs",
                "image": "rocs-service:latest",
                "imagePullPolicy": "IfNotPresent",
                "command": ["/usr/local/bin/n00b-rocs-service"],
                "args": ["--serve"],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "env": [
                  {
                    "name": "ROCS_PROFILE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_PROFILE"
                      }
                    }
                  },
                  {
                    "name": "ROCS_NAME",
                    "value": "rocs-reader"
                  },
                  {
                    "name": "ROCS_HTTP_ADDR",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_HTTP_ADDR"
                      }
                    }
                  },
                  {
                    "name": "ROCS_S3_BUCKET",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_S3_BUCKET"
                      }
                    }
                  },
                  {
                    "name": "ROCS_S3_PREFIX",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_S3_PREFIX"
                      }
                    }
                  },
                  {
                    "name": "ROCS_AWS_REGION",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_AWS_REGION"
                      }
                    }
                  },
                  {
                    "name": "ROCS_S3_PATH_STYLE",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_S3_PATH_STYLE"
                      }
                    }
                  },
                  {
                    "name": "ROCS_CACHE_DIR",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_CACHE_DIR"
                      }
                    }
                  },
                  {
                    "name": "ROCS_CACHE_BYTES",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_CACHE_BYTES"
                      }
                    }
                  },
                  {
                    "name": "ROCS_RESIDENT_BYTES",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_RESIDENT_BYTES"
                      }
                    }
                  },
                  {
                    "name": "ROCS_RESIDENT_SHARDS",
                    "valueFrom": {
                      "configMapKeyRef": {
                        "name": "rocs-service-config",
                        "key": "ROCS_RESIDENT_SHARDS"
                      }
                    }
                  },
                  {
                    "name": "ROCS_SCHEMA",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "rocs-service-schema",
                        "key": "ROCS_SCHEMA"
                      }
                    }
                  },
                  {
                    "name": "ROCS_READ_ONLY",
                    "value": "true"
                  },
                  {
                    "name": "ROCS_WRITER_MODE",
                    "value": "read_replica"
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/healthz/startup",
                    "port": "http"
                  },
                  "failureThreshold": 30,
                  "periodSeconds": 2
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz/ready",
                    "port": "http"
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz/live",
                    "port": "http"
                  },
                  "periodSeconds": 10
                },
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "rocs-cache",
                    "mountPath": "/var/cache/rocs"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "rocs-cache",
                "emptyDir": {
                  "sizeLimit": "2Gi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "rocs-writer",
        "labels": {
          "app.kubernetes.io/name": "rocs",
          "app.kubernetes.io/component": "writer"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "rocs",
          "app.kubernetes.io/component": "writer"
        },
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "rocs-reader",
        "labels": {
          "app.kubernetes.io/name": "rocs",
          "app.kubernetes.io/component": "reader"
        }
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app.kubernetes.io/name": "rocs",
