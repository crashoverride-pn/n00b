AGENTS.md
.agents/
.inspector-gadget/
# test/data/resharp/data holds the RE#/rebar reference corpus consumed by
# test_regex_engine. Only the three files the test reads are committed (~925 KB
# total); any other (large) corpora a developer provisions locally from the
# resharp-c/rebar reference set stay untracked. (The test/data/resharp/tests/
# *.toml fixtures the regex_resharp test reads are also tracked.)
test/data/resharp/data/haystacks/*
!test/data/resharp/data/haystacks/en-sampled.txt
!test/data/resharp/data/haystacks/smallserver.txt
test/data/resharp/data/regexes/*
!test/data/resharp/data/regexes/dictionary-fixed-context.txt
.aider*

# Created by chalk-tool when oracle round-trip tests run.
chalk-reports.jsonl

# Ephemeral SSH keypair + allowed_signers regenerated on every naudit signing
# test run (were accidentally tracked; now untracked + ignored).
test/fixtures/naudit/tmp_signing/id_test
test/fixtures/naudit/tmp_signing/id_test.pub
test/fixtures/naudit/tmp_signing/allowed_signers
docker/_linux_build/
# Linux dev-env: jj-tracked ncc upstream clone + its Linux build (WP-001 Phase 0).
docker/_linux_ncc/
