# ── Build artifacts ───────────────────────────────────────────────────────────
# All meson builds go in the top-level build/ directory.
# Per-project standalone builds also use build/ inside each project.
**/build*/

**/bin/
**/lib/
# Vendored upstream subprojects ship their library sources in `lib/`.
# Allow those back in.
!subprojects/*/lib/
!subprojects/*/lib/**
# n00b's own stdlib lives at top-level `lib/std/` and is loaded at
# runtime by the embedded-eval session (`src/n00b/eval.c` via
# `N00B_BUILTINS_PATH`) and by the REPL.
!/lib/
!/lib/**

# Compiled objects (shouldn't appear outside build/ but just in case)
*.o
*.a
*.so
*.dylib
*.dll
*.lib
*.exe

# ── IDE / Editor ─────────────────────────────────────────────────────────────
**/.cache/
**/.vscode/
**/.idea/
*.swp
*.swo
*~
*.kate-swp
.clangd/
**/.clangd/
compile_commands.json
**/compile_commands.json
**/.claude/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# ── VCS ──────────────────────────────────────────────────────────────────────
# jujutsu internals (the .jj dirs)
**/.jj/
.workspaces/

# Python
**/__pycache__/
*.pyc

# Unicode data cache + generated tables
.unicode_cache/
src/unicode/generated/

# Coverage / profiling
*.gcda
*.gcno
*.gcov
*.profraw
*.profdata

# Docker SDK tarballs + per-run extracted logs
docker/sdk/
docker/_linux_logs/

# Vendored subproject sources (cloned at build time)
/subprojects/mir/
/subprojects/ncc/

# Rust cargo build output for the n00b-aws-shim subproject.
/subprojects/n00b-aws-shim/target/

AGENTS.md
.agents/
.inspector-gadget/
plans/
# Sub-directories of test/data/resharp/ that hold large generated corpora;
# the test/data/resharp/tests/*.toml fixtures the regex_resharp test reads
# are tracked.
test/data/resharp/haystacks/
test/data/resharp/regexes/
.aider*

# Created by chalk-tool when oracle round-trip tests run.
chalk-reports.jsonl

# Ephemeral SSH keypair + allowed_signers regenerated on every naudit signing
# test run (were accidentally tracked; now untracked + ignored).
test/fixtures/naudit/tmp_signing/id_test
test/fixtures/naudit/tmp_signing/id_test.pub
test/fixtures/naudit/tmp_signing/allowed_signers
docker/_linux_build/
